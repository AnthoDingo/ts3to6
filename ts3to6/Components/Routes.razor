<Router AppAssembly="typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
    </Found>
    <NotFound>
        <div style="display:flex;align-items:center;justify-content:center;height:100vh;color:#888;font-family:monospace">
            404 — Not Found
        </div>
    </NotFound>
</Router>